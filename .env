# Shared, non-secret defaults. Committed to git.
# Put personal overrides in .env.local (gitignored).
# EXPO_PUBLIC_ values are bundled into the app — never put secrets here.
# Restart `yarn start --clear` after changing these.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Simulated network delay for mock services, in milliseconds.
EXPO_PUBLIC_MOCK_LATENCY_MS=800


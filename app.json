{
  "expo": {
    "name": "VAULTA",
    "slug": "vaulta",
    "version": "1.0.0",
    "scheme": "vaulta",
    "orientation": "portrait",
    "icon": "./assets/vaulta-logo/png/vaulta-app-icon-square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaulta.app"
    },
    "android": {
      "package": "com.vaulta.app",
      "adaptiveIcon": {
        "backgroundColor": "#101828",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/vaulta-logo/png/vaulta-app-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/vaulta-logo/png/vaulta-monogram-reversed.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#101828"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ee671e3b-efda-4208-b125-8c06204f0e92"
      }
    }
  }
}
